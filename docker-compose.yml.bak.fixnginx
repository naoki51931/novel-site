version: "3.9"

services:
  db:
    image: mysql:8.0
    container_name: novel-db
    restart: unless-stopped
    environment:
      MYSQL_ROOT_PASSWORD: rootpass
      MYSQL_DATABASE: novel_db
      MYSQL_USER: novel_user
      MYSQL_PASSWORD: novel_pass
    ports:
      - "3307:3306"          # ホストから触りたいとき用（本番では消してOK）
    volumes:
      - db-data:/var/lib/mysql
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost"]
      interval: 5s
      timeout: 5s
      retries: 10
      start_period: 10s

  backend:
    build:
      context: ./backend
      dockerfile: Dockerfile
    container_name: novel-backend
    restart: unless-stopped
    environment:
      DB_HOST: db
      DB_USER: novel_user
      DB_PASS: novel_pass
      DB_NAME: novel_db
      STRIPE_SECRET_KEY: ${STRIPE_SECRET_KEY}
      STRIPE_WEBHOOK_SECRET: ${STRIPE_WEBHOOK_SECRET}
      STRIPE_PRICE_ID: price_1SWnhCHU7WtsFgpUI8MMHTFx
      FRONTEND_ORIGIN: http://18.169.218.56
      FORCE_ALL_PREMIUM: "0"   # 課金環境では 0（通常判定）
    depends_on:
      db:
        condition: service_healthy

  nginx:
  certbot:
    image: certbot/certbot
    entrypoint: /bin/sh -c "sleep infinity"
    container_name: novel-certbot
    restart: unless-stopped
    ports:
      - "80:80"
    depends_on:
      - backend
    volumes:
      - ./nginx/nginx.conf:/etc/nginx/nginx.conf:ro
      - ./frontend/dist:/usr/share/nginx/html:ro

volumes:
  db-data:

