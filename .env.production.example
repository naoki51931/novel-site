# Production-oriented minimum template.
# Replace every placeholder and keep secrets out of version control.

# Database
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=novel_db
MYSQL_USER=novel_user
MYSQL_PASSWORD=change_me

# Origins
FRONTEND_ORIGIN=https://example.com
BACKEND_ORIGIN=https://example.com
VITE_BACKEND_ORIGIN=https://example.com

# Auth / JWT
JWT_SECRET_KEY=change_me
PASSWORD_RESET_EXPIRE_MINUTES=30
REGISTER_EMAIL_VERIFY_EXPIRE_MINUTES=10

# Admin
ADMIN_API_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=change_me
ADMIN_JWT_SECRET=change_me
ADMIN_JWT_EXPIRES_MINUTES=120
ADMIN_COOKIE_SECURE=1

# Admin login abuse guard
ADMIN_LOGIN_RATE_LIMIT_WINDOW_SEC=900
ADMIN_LOGIN_RATE_LIMIT_MAX_FAILURES=5

# Public contact abuse guard
PUBLIC_CONTACT_RATE_LIMIT_WINDOW_SEC=900
PUBLIC_CONTACT_RATE_LIMIT_MAX_REQUESTS=5
PUBLIC_CONTACT_DUPLICATE_WINDOW_SEC=300

# Register email abuse guard
REGISTER_EMAIL_START_RATE_LIMIT_WINDOW_SEC=900
REGISTER_EMAIL_START_RATE_LIMIT_MAX_REQUESTS=5
REGISTER_EMAIL_START_COOLDOWN_SEC=60

# Login start abuse guard
LOGIN_START_FAILURE_WINDOW_SEC=900
LOGIN_START_MAX_FAILURES=5
LOGIN_START_CODE_COOLDOWN_SEC=60

# AI chat abuse guard
AI_CHAT_TEXT_RATE_LIMIT_WINDOW_SEC=60
AI_CHAT_TEXT_RATE_LIMIT_USER_MAX_REQUESTS=20
AI_CHAT_TEXT_RATE_LIMIT_GUEST_MAX_REQUESTS=8
AI_CHAT_IMAGE_RATE_LIMIT_WINDOW_SEC=300
AI_CHAT_IMAGE_RATE_LIMIT_USER_MAX_REQUESTS=5
AI_CHAT_IMAGE_RATE_LIMIT_GUEST_MAX_REQUESTS=2

# Stripe
