<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#F4F7FB"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lexis AI 小説" android:textStyle="bold" android:textSize="24sp" android:textColor="#101828"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OpenRouterで小説を生成" android:textSize="13sp" android:textColor="#667085"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="OpenRouter APIキー：AIモデルを利用するためのキーです。" android:textSize="12sp" android:textColor="#667085"/><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp"><Button android:id="@+id/navGenerate" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="生成"/><Button android:id="@+id/navLibrary" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="小説一覧"/></LinearLayout><LinearLayout android:id="@+id/libraryPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="生成した小説一覧" android:textStyle="bold" android:textSize="20sp" android:layout_marginTop="12dp"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="生成した小説は自動で保存されます。作品をタップすると投稿・削除・ダウンロードができます。" android:textColor="#667085"/><LinearLayout android:id="@+id/libraryContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/></LinearLayout><LinearLayout android:id="@+id/generationPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"><EditText android:id="@+id/apiKey" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="OpenRouter APIキー" android:inputType="textPassword"/><Button android:id="@+id/saveApiKey" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="APIキーを安全に保存"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="AIモデル：小説生成に使うモデルです。迷った場合は openrouter/auto を使えます。" android:textSize="12sp" android:textColor="#667085"/><Spinner android:id="@+id/modelSpinner" android:layout_width="match_parent" android:layout_height="52dp"/><Button android:id="@+id/loadModels" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="モデル一覧を取得"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="作品設定：タイトル・ジャンル・登場人物・雰囲気を指定できます。" android:textSize="12sp" android:textColor="#667085" android:layout_marginTop="8dp"/><EditText android:id="@+id/titleInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="タイトル"/><EditText android:id="@+id/genreInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="ジャンル"/><EditText android:id="@+id/charactersInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="登場人物"/><EditText android:id="@+id/moodInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="雰囲気・文体"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="あらすじ・生成指示：AIに書いてほしい内容や展開を入力します。" android:textSize="12sp" android:textColor="#667085"/><EditText android:id="@+id/instructionInput" android:layout_width="match_parent" android:layout_height="120dp" android:gravity="top" android:hint="あらすじ・生成指示" android:inputType="textMultiLine"/>
<CheckBox android:id="@+id/r18Check" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="R18（全員18歳以上・合意のある成人関係のみ）"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ブロック生成" android:textStyle="bold" android:textSize="18sp" android:layout_marginTop="14dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="各ボックスに、このブロックで書いてほしい内容を入力します。最後のボックスで改行すると次のボックスを追加できます。" android:textColor="#667085"/>
<LinearLayout android:id="@+id/blockPromptContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
<Button android:id="@+id/addBlockPrompt" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="+ ブロックを追加"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ブロック数：何回に分けて生成するか（2〜12）。最大token：1回の生成で出力できる文章量の上限です。" android:textSize="12sp" android:textColor="#667085" android:layout_marginTop="8dp"/><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><EditText android:id="@+id/blockCount" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="ブロック数" android:inputType="number" android:text="3"/><EditText android:id="@+id/maxTokens" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="最大token" android:inputType="number" android:text="2000"/></LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="再試行回数" android:textStyle="bold" android:textColor="#344054" android:layout_marginTop="8dp"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="空の応答や一時的な通信エラーが起きたときに、AI生成をやり直す回数です。初期値は20回です。" android:textSize="12sp" android:textColor="#667085"/><EditText android:id="@+id/retryCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="例: 20" android:inputType="number" android:text="20"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="テンプレート：現在の作品設定に名前を付けて保存し、あとから選んで呼び出せます。" android:textSize="12sp" android:textColor="#667085" android:layout_marginTop="10dp"/><EditText android:id="@+id/templateName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="テンプレート名"/><Button android:id="@+id/saveTemplate" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="テンプレート保存"/><Spinner android:id="@+id/templateSpinner" android:layout_width="match_parent" android:layout_height="52dp"/><Button android:id="@+id/loadTemplate" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="選択したテンプレートを読み込む"/>
<Button android:id="@+id/generate" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="通常生成"/><Button android:id="@+id/generateBlocks" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ブロック生成"/><Button android:id="@+id/continueButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="続きを生成"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="通常生成＝一度に生成 ／ ブロック生成＝分割して長文生成 ／ 続きを生成＝現在の本文の続きから生成" android:textSize="12sp" android:textColor="#667085" android:layout_marginTop="8dp"/><ProgressBar android:id="@+id/progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"/><TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#475467" android:padding="6dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="生成結果：文章欄の中を上下にスワイプして長文を読めます。" android:textSize="12sp" android:textColor="#667085"/><EditText android:id="@+id/resultText" android:layout_width="match_parent" android:layout_height="360dp" android:gravity="top|start" android:background="#FFFFFF" android:padding="12dp" android:inputType="textMultiLine|textCapSentences" android:hint="生成結果" android:scrollbars="vertical" android:overScrollMode="always" android:fadeScrollbars="false" android:scrollbarStyle="insideInset" android:longClickable="true" android:textIsSelectable="true"/>
<Button android:id="@+id/saveDraft" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="端末に下書き保存"/><Button android:id="@+id/shareText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TXTとして共有"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lexisへ投稿" android:textStyle="bold" android:textSize="18sp" android:layout_marginTop="18dp"/><EditText android:id="@+id/lexisEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Lexis メールアドレス"/><EditText android:id="@+id/lexisPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Lexis パスワード" android:inputType="textPassword"/><Button android:id="@+id/uploadLexis" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Lexisへアップロード"/>
</LinearLayout></LinearLayout></ScrollView>