# Development template.
# Safe defaults for local Docker / manual startup.

# Database
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=novel_db
MYSQL_USER=novel_user
MYSQL_PASSWORD=novel_pass

# Origins
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_ORIGIN=http://localhost:8000
VITE_BACKEND_ORIGIN=http://localhost:8000

# Auth / JWT
JWT_SECRET_KEY=change_me_local_only
PASSWORD_RESET_EXPIRE_MINUTES=30
REGISTER_EMAIL_VERIFY_EXPIRE_MINUTES=10

# Admin
ADMIN_API_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=change_me
ADMIN_JWT_SECRET=change_me_local_only
ADMIN_JWT_EXPIRES_MINUTES=120
ADMIN_COOKIE_SECURE=0

# Admin login abuse guard
ADMIN_LOGIN_RATE_LIMIT_WINDOW_SEC=900
ADMIN_LOGIN_RATE_LIMIT_MAX_FAILURES=5

# Public contact abuse guard
PUBLIC_CONTACT_RATE_LIMIT_WINDOW_SEC=900
PUBLIC_CONTACT_RATE_LIMIT_MAX_REQUESTS=5
PUBLIC_CONTACT_DUPLICATE_WINDOW_SEC=300

# Register email abuse guard
REGISTER_EMAIL_START_RATE_LIMIT_WINDOW_SEC=900
REGISTER_EMAIL_START_RATE_LIMIT_MAX_REQUESTS=5
REGISTER_EMAIL_START_COOLDOWN_SEC=60

# Login start abuse guard
LOGIN_START_FAILURE_WINDOW_SEC=900
LOGIN_START_MAX_FAILURES=5
LOGIN_START_CODE_COOLDOWN_SEC=60

# AI chat abuse guard
AI_CHAT_TEXT_RATE_LIMIT_WINDOW_SEC=60
AI_CHAT_TEXT_RATE_LIMIT_USER_MAX_REQUESTS=20
AI_CHAT_TEXT_RATE_LIMIT_GUEST_MAX_REQUESTS=8
AI_CHAT_IMAGE_RATE_LIMIT_WINDOW_SEC=300
AI_CHAT_IMAGE_RATE_LIMIT_USER_MAX_REQUESTS=5
AI_CHAT_IMAGE_RATE_LIMIT_GUEST_MAX_REQUESTS=2

# Stripe
STRIPE_USE_TEST=1
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_PRICE_ID_1000=
STRIPE_PRICE_ID_3000=
STRIPE_PRICE_ID_5000=
STRIPE_WEBHOOK_SECRET=
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_PRICE_ID=
STRIPE_TEST_PRICE_ID_1000=
STRIPE_TEST_PRICE_ID_3000=
STRIPE_TEST_PRICE_ID_5000=
STRIPE_TEST_WEBHOOK_SECRET=
PLATFORM_FEE_RATE=0.2
MOON_ARCANA_ORIGIN=https://moon-arcana.com

# OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
X_OAUTH_CONSUMER_KEY=
X_OAUTH_CONSUMER_SECRET=

# Mail
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_USE_TLS=false
SMTP_FROM=dev@example.local

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_ENABLED=1

# AI providers
OPENAI_API_KEY=
OPENAI_MODEL_TEXT=gpt-4.1-mini
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_CHAT_OPENROUTER_FALLBACK_MODELS=moonshotai/kimi-k2,google/gemini-2.5-flash-lite
DEEPSEEK_API_KEY=
TRANSLATION_PROVIDER=openai
TRANSLATION_MODEL_TEXT=gpt-4.1
TRANSLATION_AI_TIMEOUT_SECONDS=300

# AI chat budget
AI_CHAT_FREE_TOKENS=2000000
AI_CHAT_GUEST_TOKENS=2000000
AI_CHAT_BLOCK_TOKENS=2000000
AI_CHAT_BLOCK_PRICE_YEN=1000
AI_CHAT_PREMIUM_INCLUDED_BLOCKS=1
AI_CONSULTATION_FREE_TOKENS=200000
AI_CONSULTATION_GUEST_TOKENS=50000
AI_CONSULTATION_PREMIUM_TOKENS=2000000

# AI image generation
AI_CHAT_IMAGE_API_BASE_URL=
AI_CHAT_IMAGE_API_KEY=
AI_CHAT_IMAGE_MODEL_ID=
AI_CHAT_IMAGE_NEGATIVE_PROMPT=
AI_CHAT_IMAGE_TIMEOUT_SEC=600
AI_CHAT_IMAGE_QUALITY_RETRY_ENABLED=1
AI_CHAT_IMAGE_QUALITY_MIN_SCORE=140
AI_CHAT_IMAGE_QUALITY_MAX_RETRIES=5
AI_CHAT_IMAGE_QUALITY_SAMPLE_SIZE=1
AI_CHAT_IMAGE_OOM_RETRY_ENABLED=1
AI_CHAT_IMAGE_OOM_RETRY_SCALE=0.62
AI_CHAT_IMAGE_OOM_RETRY_STEPS=20
AI_CHAT_IMAGE_INIT_STRENGTH=0.75

# reCAPTCHA
RECAPTCHA_ENABLED=0
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SITE_KEY=
VITE_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_PROJECT_ID=
RECAPTCHA_SERVICE_ACCOUNT_JSON=
RECAPTCHA_ENTERPRISE_ENABLED=0
RECAPTCHA_MIN_SCORE=0.3

# Web Push
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_SUBJECT=mailto:dev@example.local

# Firebase
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_FILE=

# SEO / Indexing
INDEXNOW_ENABLED=0
INDEXNOW_KEY=
INDEXNOW_HOST=
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow
GOOGLE_INDEXING_DAILY_SUBMIT_LIMIT=199
GOOGLE_INDEXING_CARRYOVER_TTL_SEC=2592000
GOOGLE_INDEXING_SERVICE_ACCOUNT_JSON=
GOOGLE_SEARCH_CONSOLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SEARCH_CONSOLE_SITE_URL=

# Misc
PREMIUM_REVALIDATE_DAYS=30
FORCE_PREMIUM_USERNAMES=
BOARD_NOTIFY_USERNAME=demo02
# Local CPU LLM (GGUF / llama.cpp)
LOCAL_LLM_BASE_URL=http://local-llm:8000
LOCAL_LLM_HOST_PORT=8008
LOCAL_LLM_TIMEOUT_SECONDS=1800
LOCAL_LLM_THREADS=8
LOCAL_LLM_CONTEXT_SIZE=32768
LOCAL_LLM_PRELOAD_MODEL=
LOCAL_LLM_DOUJINSHI_MODEL_PATH=/models/doujinshi-14b/Doujinshi-14b-roleplay-Q4_K_M.gguf
LOCAL_LLM_JPRP_MODEL_PATH=/models/llama3-jprp-8b/Llama-3-JPRP-NSFW-8B.Q4_K_M.gguf
LOCAL_LLM_QWEN_MODEL_PATH=/models/qwen3-8b-nsfw-jp/Qwen3-8B-NSFW-JP.Q4_K_M.gguf
